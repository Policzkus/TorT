--!strict
-- The game's own playable characters (PROMPT §V2.3: nobody plays as their Roblox avatar). Each one
-- is an AI mesh (Roblox Studio generate_mesh, owner's account) generated in six segments;
-- Modules/CharacterRig joins them into a Humanoid rig. Sizes and offsets are in studs after
-- scaling; an offset is the segment's centre relative to the point between the feet, with the
-- character facing -Z. eye = eye height (default: 60% up the head segment; set it when a hat makes
-- the head segment tall).
-- The homeowners are modelled in Blender (Config/CharacterModels, generated by art/scripts/characters.py)
-- and merged in at the end: their meshes are imported assets, not ids, and they say where their
-- joints are (pivots).

export type Segment = { mesh: number?, texture: number?, size: { number }, offset: { number } }
export type Character = {
	segments: { [string]: Segment },
	eye: number?,
	pivots: { [string]: { number } }?, -- Neck, LeftShoulder, RightShoulder, LeftHip, RightHip
	face: { number }?, -- the middle of the face (a Blender homeowner's head part may hold long hair, a veil)
	outline: { { number } }?, -- the head's and torso's top seen from the side: { height, z } (HomeownerController)
}

local CharacterModels = require(script.Parent.CharacterModels) :: { [string]: Character }

